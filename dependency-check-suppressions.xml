<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWASP Dependency-Check 오탐 억제 목록 (2026-09-21 첫 완주 스캔 기준).
  각 항목은 "왜 우리 코드 경로에 해당하지 않는가"를 적는다. 근거 없는 억제는 추가하지 말 것.
  실행: ./gradlew dependencyCheckAnalyze  (NVD_API_KEY 셸 환경변수 권장)
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!-- gRPC-Go(grpc/grpc CPE)의 CVE가 Java gRPC(io.grpc, firebase-admin 경유)에 매칭된 오탐.
         CVE-2026-33186은 Go 구현의 인가 우회이며 Java 구현과 코드베이스가 다르다. -->
    <suppress>
        <notes>gRPC-Go CVE가 grpc-java에 CPE 오매칭</notes>
        <packageUrl regex="true">^pkg:maven/io\.grpc/grpc-.*$</packageUrl>
        <cpe>cpe:/a:grpc:grpc</cpe>
    </suppress>

    <!-- OpenTelemetry-Go SDK CVE가 Java opentelemetry 아티팩트(firebase-admin 경유, 우리 코드 미사용)에 매칭된 오탐. -->
    <suppress>
        <notes>OpenTelemetry-Go CVE가 opentelemetry-java에 CPE 오매칭</notes>
        <packageUrl regex="true">^pkg:maven/io\.opentelemetry.*$</packageUrl>
        <cpe>cpe:/a:opentelemetry:opentelemetry</cpe>
    </suppress>

    <!-- protobuf Python(json_format.ParseDict) DoS CVE-2026-0994가 protobuf-java에 매칭된 오탐. -->
    <suppress>
        <notes>protobuf Python 전용 CVE가 protobuf-java에 매칭</notes>
        <packageUrl regex="true">^pkg:maven/com\.google\.protobuf/protobuf-java.*$</packageUrl>
        <cve>CVE-2026-0994</cve>
    </suppress>

    <!-- log4j-api는 log4j-to-slf4j 브리지가 끌어오는 API 아티팩트뿐이다(우리 로깅은 logback).
         Layout 계열 CVE(CVE-2026-34478~34481)는 log4j-core 구현에만 해당한다. -->
    <suppress>
        <notes>log4j-core 전용 Layout CVE가 log4j-api에 매칭. 런타임 구현은 logback</notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j-api@.*$</packageUrl>
        <cpe>cpe:/a:apache:log4j</cpe>
    </suppress>

    <!-- Jakarta Mail SMTP 인젝션 CVE-2025-7962는 angus-mail(우리는 Boot 4.0.8 관리 2.0.5) 대상이며,
         angus-activation은 별개 아티팩트(활성화 프레임워크)라 CPE 오매칭. -->
    <suppress>
        <notes>Jakarta Mail CVE가 angus-activation에 CPE 오매칭</notes>
        <packageUrl regex="true">^pkg:maven/org\.eclipse\.angus/angus-activation@.*$</packageUrl>
        <cve>CVE-2025-7962</cve>
    </suppress>

</suppressions>
